# Copy to .env.local (never commit .env.local)
# Values: Supabase dashboard → Project Settings → API

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: disable the 20s idle screensaver (click logo to hard-refresh the app)
# REACT_APP_DISABLE_IDLE_SCREENSAVER=true
